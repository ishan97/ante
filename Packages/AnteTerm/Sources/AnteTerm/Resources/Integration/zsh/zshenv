# Ante zsh shell integration — stage 1 of 3 (.zshenv).
#
# Ante launches zsh with ZDOTDIR pointing at this directory and ANTE_USER_ZDOTDIR holding the
# user's own ZDOTDIR (unset when they use $HOME). zsh re-reads ZDOTDIR before each startup file,
# so each shim file sources the user's real counterpart and hands ZDOTDIR back at the end of
# .zshrc. The user's files are never modified.
if [[ -z "$ANTE_ZDOTDIR_SHIM" ]]; then
  export ANTE_ZDOTDIR_SHIM="$ZDOTDIR"
fi
_ante_user_zdotdir="${ANTE_USER_ZDOTDIR:-$HOME}"
if [[ -f "$_ante_user_zdotdir/.zshenv" ]]; then
  ZDOTDIR="$_ante_user_zdotdir"
  source "$_ante_user_zdotdir/.zshenv"
fi
ZDOTDIR="$ANTE_ZDOTDIR_SHIM"
